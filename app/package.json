{
    "name": "sftoomi",
    "version": "0.5.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --host 0.0.0.0",
        "build": "ng build --configuration production",
        "dev:watch": "ng build --configuration development --watch --poll 1000",
        "dev:hot-watch": "ng serve --configuration development --host 0.0.0.0",
        "test": "vitest run",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^22.2.4",
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/material": "^22.2.4",
        "@angular/platform-browser": "^22.2.3",
        "@angular/router": "^22.2.3",
        "@maskito/angular": "^5.6.0",
        "@maskito/core": "^5.6.0",
        "@maskito/kit": "^5.6.0",
        "@maskito/phone": "^5.6.0",
        "@ng-util/monaco-editor": "^22.0.0",
        "@types/luxon": "3.7.6",
        "luxon": "^3.7.2",
        "ng-zorro-antd": "^22.1.2",
        "ngx-extended-pdf-viewer": "^31.0.1",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22.2.4",
        "@angular/cli": "^22.2.4",
        "@angular/compiler-cli": "^22.2.3",
        "@eslint/js": "^10.0.1",
        "@types/jasmine": "7.0.0",
        "angular-eslint": "22.6.0",
        "eslint": "^10.13.0",
        "jasmine-core": "~7.0.2",
        "jsdom": "^30.1.3",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.3.0",
        "less": "^4.9.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.0",
        "vitest": "^5.0.5"
    }
}
