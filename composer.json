{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.5",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpmailer/phpmailer": "^7.1.1",
        "phpstan/phpdoc-parser": "^2.3.6",
        "symfony/cache": "^8.1.9",
        "symfony/console": "^8.1.9",
        "symfony/doctrine-messenger": "^8.1.9",
        "symfony/dotenv": "^8.1.6",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "^8.1.9",
        "symfony/http-client": "8.*",
        "symfony/intl": "^8.1.5",
        "symfony/messenger": "^8.1.9",
        "symfony/monolog-bundle": "^4.1",
        "symfony/property-access": "^8.1.4",
        "symfony/property-info": "^8.1.8",
        "symfony/runtime": "^8.1.9",
        "symfony/security-bundle": "^8.1.9",
        "symfony/serializer": "^8.1.9",
        "symfony/translation": "^8.1.5",
        "symfony/yaml": "^8.1.9"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.*"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.3",
        "symfony/browser-kit": "^8.1.9",
        "symfony/css-selector": "^8.1.6",
        "symfony/maker-bundle": "^1.68",
        "symfony/phpunit-bridge": "^8.1.9"
    }
}
